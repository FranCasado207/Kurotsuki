<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kurotsuki.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://kurotsuki-next/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Colours come from the active theme (ThemeManager rewrites the palette and the Kt* brushes at startup). -->
    <FluentTheme />
    <StyleInclude Source="avares://kurotsuki-next/Styles.axaml" />
  </Application.Styles>
</Application>
