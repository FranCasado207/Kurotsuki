<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kurotsuki.App.ViewModels"
        xmlns:svc="using:Kurotsuki.App.Services"
        x:Class="Kurotsuki.App.Views.TransferWindow"
        x:DataType="vm:TransferViewModel"
        Title="{svc:T 'transfer.title'}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="28,24" Spacing="14">
    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />
    <CheckBox Content="{Binding IncludeKeysText}" IsChecked="{Binding IncludeKeys}" IsEnabled="{Binding CanStart}" />
    <Button Classes="accent" Content="{svc:T 'transfer.show'}" Command="{Binding ShowCommand}" HorizontalAlignment="Left" />
    <Border IsVisible="{Binding Qr, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" Background="White" Padding="10" CornerRadius="10">
      <Image Source="{Binding Qr}" Width="300" Height="300" />
    </Border>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock Foreground="{DynamicResource KtDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding FirewallHint}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{svc:T 'next.copyLink'}" Command="{Binding CopyLinkCommand}" IsVisible="{Binding Running}" />
      <Button Content="{svc:T 'next.close'}" Click="OnClose" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
