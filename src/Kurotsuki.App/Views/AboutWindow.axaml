<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:Kurotsuki.App.Services"
        x:Class="Kurotsuki.App.Views.AboutWindow"
        Title="{svc:T 'about.title'}" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="32,28" Spacing="8" HorizontalAlignment="Center">
    <Border Width="96" Height="96" CornerRadius="24" ClipToBounds="True" HorizontalAlignment="Center"><Image Source="avares://kurotsuki-next/Assets/kurotsuki.png" Stretch="UniformToFill" /></Border>
    <TextBlock Text="Kurotsuki" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock x:Name="VersionText" HorizontalAlignment="Center" />
    <TextBlock Text="{svc:T 'about.description'}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    <TextBlock x:Name="AuthorText" Classes="muted" HorizontalAlignment="Center" />
    <Button Classes="accent" Content="{svc:T 'next.close'}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnClose" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
